# APM dependencies
apm_modules/
# Lockfile: sin dependencias solo registra hashes de archivos generados.
# Versionarlo si se agregan dependencias en apm.yml.
apm.lock.yaml

# Agentes generados por `apm install` a partir de .apm/agents/ (la fuente es .apm/)
.claude/agents/
.github/agents/
.opencode/agents/
.kiro/agents/

# Skills generadas por `apm install` a partir de .apm/skills/
.claude/skills/
.agents/skills/
.kiro/skills/

# Instrucciones generadas por `apm install` a partir de .apm/instructions/
.claude/rules/
.github/instructions/
.kiro/steering/

# Configuración local de Claude Code
.claude/settings.local.json

# macOS
.DS_Store
